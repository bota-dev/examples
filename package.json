{
  "name": "@bota-dev/examples",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "postinstall": "node scripts/patch-query-string.mjs && node scripts/apply-node-forge-security-patch.mjs && node scripts/apply-braces-security.mjs",
    "test": "node --test scripts/test-*.mjs",
    "dev": "npm run dev -w @bota-dev/example-backend",
    "dev:backend": "npm run dev -w @bota-dev/example-backend",
    "dev:react-native": "npm run start -w @bota-dev/example-react-native",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:node-forge-security": "node --test scripts/test-node-forge-security.mjs",
    "test:braces-security": "node --test scripts/test-braces-security.mjs"
  },
  "overrides": {
    "query-string@7.1.3": {
      "decode-uri-component": "0.5.0"
    },
    "xcode@3.0.1": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": ">=22.23.2"
  }
}
