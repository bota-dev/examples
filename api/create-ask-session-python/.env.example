# Explicit server-side configuration; main.py does not load this file.
BOTA_API_BASE_URL=https://api.bota.dev/v1
# The key needs Ask access, recordings:read and end_users:read.
BOTA_API_KEY=sk_test_REPLACE_ME
BOTA_PROJECT_ID=proj_REPLACE_ME
BOTA_END_USER_ID=eu_REPLACE_ME
BOTA_RECORDING_ID=rec_REPLACE_ME
# Parent must already exist and be private: POSIX mode 0700; Windows user-only ACL.
BOTA_JOURNAL_PATH=.state/ask.sqlite
BOTA_MAX_PAGES=5
