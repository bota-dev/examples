# Explicitly choose the API environment; this URL is production.
BOTA_API_BASE_URL=https://api.bota.dev/v1
# Server-only project credential with recordings:read. Never put it in an app.
BOTA_API_KEY=replace_me
# Optional: filter to an existing end user in that project. Blank lists project records.
BOTA_END_USER_ID=
# API page size, 1-100.
BOTA_LIMIT=20
# Example's maximum page requests, 1-50. A cap hit reports incomplete (exit 2).
BOTA_MAX_PAGES=5
