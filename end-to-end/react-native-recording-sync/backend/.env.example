# Server only. Production Bota API; deliberately choose your test project.
BOTA_API_BASE_URL=https://api.bota.dev/v1
BOTA_API_KEY=sk_test_replace_me
BOTA_STORAGE_HOSTS=your-independent-audio-bucket.s3.region.amazonaws.com
BOTA_PROJECT_ID=proj_replace_me
BOTA_END_USER_ID=eu_replace_me
# Leave blank for cloud-library-only mode. Device sync requires an existing bound dev_*.
# Adding/changing a device later requires its own capture journal; never replace an uncertain journal.
BOTA_DEVICE_ID=
# Generate a separate random application token (at least 32 characters).
# This is the only token configured in the phone app; never use BOTA_API_KEY.
APP_ACCESS_TOKEN=replace_with_a_random_application_token
PORT=8787
JOURNAL_PATH=./data/recording-sync.sqlite
# Optional separate durable cloud-action journal; defaults to JOURNAL_PATH + .library.sqlite.
# Never point this at the native capture journal. API-key rotation requires operator reconciliation.
# LIBRARY_JOURNAL_PATH=./data/library.sqlite
