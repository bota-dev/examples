{
  "name": "@bota-examples/recording-sync-app",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test *.test.mjs && npm run test:native-expo-signing && npm run test:braces-security && npm run test:source-map-security",
    "export": "expo export --platform android --max-workers 2",
    "postinstall": "node scripts/verify-native-expo-signing.mjs && node scripts/apply-braces-security.mjs",
    "test:braces-security": "node --test scripts/test-braces-security.mjs",
    "test:source-map-security": "node --test scripts/test-source-map-security.mjs",
    "license-check": "node scripts/check-licenses.mjs",
    "test:native-expo-signing": "node --test scripts/test-native-expo-signing.mjs"
  },
  "engines": {
    "node": ">=22.23.2"
  },
  "dependencies": {
    "@bota.dev/react-native-app-sdk": "2.0.0-beta.13",
    "expo": "57.0.4",
    "expo-build-properties": "57.0.22",
    "react": "19.3.0",
    "react-native": "0.87.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "6.0.3",
    "@expo/cli": "file:vendor/expo-native-signing/expo-cli-57.0.27+examples.native.1.v2.tgz",
    "@expo/code-signing-certificates": "file:vendor/expo-native-signing/code-signing-certificates-0.0.6+examples.native.1.v3.tgz",
    "@expo/metro-file-map": "file:vendor/metro-public-matching/expo-metro-file-map-57.0.3.public-some.tgz",
    "metro-file-map": "file:vendor/metro-public-matching/metro-file-map-0.84.5.public-some.tgz"
  },
  "type": "module",
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    },
    "@expo/cli": "$@expo/cli",
    "@expo/code-signing-certificates": "$@expo/code-signing-certificates",
    "@expo/metro-file-map": "$@expo/metro-file-map",
    "metro-file-map": "$metro-file-map"
  }
}
