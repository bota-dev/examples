# Keep this file private after copying it to .env. All live identity values are operator supplied.
APP_MODE=live
PORT=5173
APP_ORIGIN=http://127.0.0.1:5173

# Absolute source/legacy launch bases; replace these examples with your checkout paths.
WEB_LAUNCH_DIR=/absolute/path/to/examples/end-to-end/web-reference
MOBILE_LAUNCH_DIR=/absolute/path/to/examples/end-to-end/react-native-recording-sync/backend

# For migration, set the ORIGINAL absolute paths. Never move/delete journals to force startup.
# Defaults remain accounts.json + .state/reference.sqlite in Web, data/recording-sync.sqlite in Mobile.
# Fresh installations can use new private directories, then npm run initialize once.
# WEB_ACCOUNTS_FILE=/absolute/private/path/accounts.json
# WEB_STATE_DIR=/absolute/private/path/web-state
# MOBILE_JOURNAL_PATH=/absolute/private/path/recording-sync.sqlite
# MOBILE_LIBRARY_JOURNAL_PATH=/absolute/private/path/recording-sync.sqlite.library.sqlite

BOTA_API_BASE_URL=https://api.bota.dev/v1
BOTA_API_KEY=
BOTA_PROJECT_ID=
BOTA_END_USER_ID=
APP_ACCESS_TOKEN=
# Only needed if more than one Web account maps to the fixed mobile end user.
# MOBILE_ACCOUNT_USERNAME=
# Optional; omit for cloud-only library/results. Configure an already-bound device for native sync.
BOTA_DEVICE_ID=
# Optional owned exact storage host list and webhook secret, same Web contracts as before.
BOTA_STORAGE_HOSTS=
WEBHOOK_SECRET=
