{
  "name": "@bota-examples/web-reference",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.2"
  },
  "scripts": {
    "demo": "node server/main.mjs --demo --dev",
    "dev": "node --env-file-if-exists=.env server/main.mjs --dev",
    "start": "node --env-file-if-exists=.env server/main.mjs",
    "account": "node --env-file-if-exists=.env scripts/create-account.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint server web tests scripts vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test:server": "node --test tests/server/*.test.mjs",
    "test:ui": "vitest run",
    "test": "npm run test:server && npm run test:ui",
    "build": "npm run typecheck && vite build",
    "license-check": "node scripts/check-licenses.mjs"
  },
  "dependencies": {
    "@bota.dev/web-app-sdk": "2.0.0-beta.20",
    "express": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "globals": "16.5.0",
    "jsdom": "30.1.2",
    "prettier": "3.8.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
