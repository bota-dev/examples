# Live mode only. npm run demo uses synthetic data without Bota networking.
APP_MODE=live
APP_ORIGIN=http://127.0.0.1:5173
PORT=5173
BOTA_API_BASE_URL=https://api.bota.dev/v1
BOTA_API_KEY=
BOTA_PROJECT_ID=
# Comma-separated exact trusted upload hosts; obtain from your operator context.
BOTA_STORAGE_HOSTS=
# Obtain this endpoint's signing secret through your authorized operator setup.
WEBHOOK_SECRET=
ACCOUNTS_FILE=./accounts.json
STATE_DIR=./.state
